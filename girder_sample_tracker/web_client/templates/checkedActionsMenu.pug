li.g-checked-menu-header.dropdown-header(role="presentation")
  if pickedCount
    i.icon-plus-circled
    //- The count can exceed the rows on screen: a selection survives a page
    //- turn and a change of filter, so say what it is rather than leaving
    //- the user to count checkboxes.
    span.g-checked-picked-count #{pickedCount}
    |  selected
if pickedCount
  li
    a.g-download-checked
      i.icon-download
      | Download QR codes for selected samples
  li
    a.g-add-event
      i.icon-plus
      | Add event to selected samples

  if (minSampleLevel >= AccessType.ADMIN)
    li.g-admin.divider
    li.g-admin
      a.g-access-checked
        i.icon-lock
        | Change access to selected samples
      a.g-delete-checked
        i.icon-trash
        | Delete checked samples

  li.divider
  li
    a.g-clear-checked
      i.icon-cancel
      | Clear selection
